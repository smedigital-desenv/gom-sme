diff -ruN base/sql/11_garantia_servico_e_anexos_drive.sql gom/sql/11_garantia_servico_e_anexos_drive.sql
--- base/sql/11_garantia_servico_e_anexos_drive.sql	1970-01-01 00:00:00.000000000 +0000
+++ gom/sql/11_garantia_servico_e_anexos_drive.sql	2026-06-12 22:43:39.636057899 +0000
@@ -0,0 +1,41 @@
+-- ============================================================================
+-- GOM | SME — Migração 11: Garantia de Serviço + anexos no Google Drive
+-- ----------------------------------------------------------------------------
+-- Executar no SQL Editor do Supabase. Idempotente (pode rodar mais de uma vez).
+-- ============================================================================
+
+-- ─── 1) Novo status "Garantia de Serviço" ────────────────────────────────────
+-- Diferente de "Garantia de Obra". É a decisão da GOM na validação de um
+-- "Serviço Realizado": o chamado volta à Empresa para correção em garantia.
+-- Necessário ANTES do deploy do frontend: historico_equipes.status e
+-- log_acoes referenciam status_chamado(codigo) — sem o seed, o salvamento falha.
+insert into public.status_chamado (codigo, cor, ordem) values
+  ('Garantia de Serviço', '#a855f7', 95)
+on conflict (codigo) do update set cor = excluded.cor, ordem = excluded.ordem;
+
+-- ─── 2) Anexos no Google Drive ───────────────────────────────────────────────
+-- Coluna `url`: URL pública do arquivo no Drive (storage_path = 'drive:<id>').
+-- Anexos antigos (Supabase Storage) ficam com url = null e continuam sendo
+-- lidos por URL assinada do bucket — nenhuma migração de arquivos é necessária.
+alter table public.anexos
+  add column if not exists url text;
+
+comment on column public.anexos.url is
+  'URL pública do arquivo (Google Drive). Null = anexo legado no Supabase Storage, lido por URL assinada.';
+
+-- ─── 3) Garantia de RLS para gravar metadados de anexos ─────────────────────
+-- Se o erro atual ao salvar anexos for de RLS na tabela `anexos`, esta política
+-- resolve. (O upload do ARQUIVO em si deixa de usar o Storage e vai ao Drive.)
+drop policy if exists anexos_insert_app on public.anexos;
+create policy anexos_insert_app on public.anexos
+  for insert to anon, authenticated
+  with check (true);
+
+drop policy if exists anexos_select_app on public.anexos;
+create policy anexos_select_app on public.anexos
+  for select to anon, authenticated
+  using (true);
+
+-- ─── Conferências rápidas ────────────────────────────────────────────────────
+-- select codigo, cor, ordem from public.status_chamado order by ordem;
+-- select id, solicitacao_id, categoria, nome, storage_path, url from public.anexos order by id desc limit 10;
